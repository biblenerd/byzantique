---
// "Referenced elsewhere" — notes elsewhere in the corpus that reference this chapter's
// verses (grouped by verse), plus whole-book notes that discuss the chapter (one row each,
// listing the verses they touch). On the book landing page it's a flat list (`flat`).
// Collapsible when long. REQUIREMENTS.md §5.6.
import type { BacklinkGroup, Backlink, BookNoteBacklink } from '../lib/commentary';

interface Props {
  groups: BacklinkGroup[];
  bookNotes?: BookNoteBacklink[];
  total: number;
  flat?: boolean; // book-level: list entries without per-verse grouping
}
const { groups, bookNotes = [], total, flat = false } = Astro.props;
const collapsible = total > 5;
const verb = (k: string) => (k === 'quote' ? 'quoted in' : 'cited in');
const label = (e: Backlink) => (e.title ? e.title : `Note on ${e.src}`);
const vlist = (vv: number[]) => (vv.length === 1 ? `v. ${vv[0]}` : `vv. ${vv.join(', ')}`);
const flatEntries = groups.flatMap((g) => g.entries);
---

{total > 0 && (
  <section class="backlinks ui" data-pagefind-ignore>
    {collapsible ? (
      <details class="backlinks-d">
        <summary>Referenced elsewhere · {total} note{total === 1 ? '' : 's'}</summary>
        <ul>
          {flat
            ? flatEntries.map((e) => (
                <li>{verb(e.kind)}{' '}<a href={e.href}>{label(e)}</a>{e.title && ` (${e.src})`}</li>
              ))
            : groups.map((g) => (
                <li>
                  <span class="bl-v">v.&nbsp;{g.verse}</span>
                  {g.entries.map((e, i) => (
                    <Fragment>{i > 0 ? '; ' : ' — '}{verb(e.kind)}{' '}<a href={e.href}>{label(e)}</a>{e.title && ` (${e.src})`}</Fragment>
                  ))}
                </li>
              ))}
          {bookNotes.map((e) => (
            <li><a href={e.href}>{e.title || 'Book note'}</a><span class="bl-book"> · book note ({vlist(e.verses)})</span></li>
          ))}
        </ul>
      </details>
    ) : (
      <Fragment>
        <div class="col-label bl-head">Referenced elsewhere</div>
        <ul>
          {flat
            ? flatEntries.map((e) => (
                <li>{verb(e.kind)}{' '}<a href={e.href}>{label(e)}</a>{e.title && ` (${e.src})`}</li>
              ))
            : groups.map((g) => (
                <li>
                  <span class="bl-v">v.&nbsp;{g.verse}</span>
                  {g.entries.map((e, i) => (
                    <Fragment>{i > 0 ? '; ' : ' — '}{verb(e.kind)}{' '}<a href={e.href}>{label(e)}</a>{e.title && ` (${e.src})`}</Fragment>
                  ))}
                </li>
              ))}
          {bookNotes.map((e) => (
            <li><a href={e.href}>{e.title || 'Book note'}</a><span class="bl-book"> · book note ({vlist(e.verses)})</span></li>
          ))}
        </ul>
      </Fragment>
    )}
  </section>
)}
